{
  "name": "@drawai/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:plugin": "tsc && vite build --config vite.plugin.config.ts && node studio/inline-build.mjs",
    "studio:serve": "node studio/server.mjs --http=8896",
    "studio:mcp": "node studio/server.mjs",
    "test:studio": "node --test studio/tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fflate": "^0.8.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
