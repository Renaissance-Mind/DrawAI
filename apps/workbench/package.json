{
  "name": "@drawai/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc && vite build && node templates/copy-catalog.mjs dist",
    "preview": "vite preview",
    "build:plugin": "tsc && vite build --config vite.plugin.config.ts && node templates/inline-build.mjs",
    "build:templates": "tsc && vite build --config vite.templates.config.ts && node templates/copy-catalog.mjs dist-templates --index",
    "preview:templates": "vite preview --config vite.templates.config.ts --host 127.0.0.1",
    "templates:mcp": "node templates/server.mjs",
    "test:templates": "node --test templates/tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
